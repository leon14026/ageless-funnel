# Security response headers for the Ageless by Tulee site.
#
# Cloudflare Workers static assets reads this file from the assets directory
# (./public, per wrangler.jsonc). The file itself is never served to visitors.
# Limits: 100 rules, 2000 characters per line.
#
# These headers apply ONLY to the static site. Responses generated by the
# Supabase Edge Functions (initiate-payment, payment-ipn, payment-return,
# validate-payment) are a different origin and set their own headers.

/*
  # Never load this site over plain HTTP again, for a year. Cloudflare already
  # redirects http -> https, but a redirect still exposes the first request;
  # this makes the browser refuse to send it at all.
  # Note: no "preload" directive. Preloading is hard to reverse and would bind
  # every present and future subdomain to HTTPS-only.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Do not let the browser guess a response's type. Stops a file served as
  # text/plain or an image from being executed as script.
  X-Content-Type-Options: nosniff

  # Send only the origin (not the full path or query) to other sites.
  # Concretely: /pages/payment/signup-success carries ?tran_id=ABT_..., and
  # without this the customer's transaction id leaks in the Referer header to
  # every third party the page loads, Google Analytics included.
  Referrer-Policy: strict-origin-when-cross-origin

  # No one may frame this site. Checkout and the member area are the targets
  # that matter: an invisible iframe over a look-alike page is how clickjacking
  # steals a click on "Pay" or "Confirm".
  X-Frame-Options: DENY

  # Switch off browser capabilities this site never uses, so an injected or
  # compromised script cannot reach for them either.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()

# Deliberately NOT set here yet: Content-Security-Policy.
# The site uses inline style="" attributes and inline <script> blocks
# throughout, so a strict script-src/style-src would break rendering
# immediately. CSP ships as a separate change, as
# Content-Security-Policy-Report-Only first, and is only enforced once the
# reports come back clean. See the security checklist for the drafted policy.
